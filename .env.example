# ==============================================================================
# Configuración de Entorno - PDF Infrastructure (Traefik Reverse Proxy & Cache)
# Cátedra: UTN FR San Rafael - Desarrollo de Software
# ==============================================================================

# Entorno de ejecución (development / staging / production)
ENVIRONMENT=development

# Puertos expuestos para Traefik
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# Nombre de la red externa compartida de Docker
DOCKER_NETWORK_NAME=pdf-network

# Dominio base y dominios para los servicios
BASE_DOMAIN=universidad.localhost
TRAEFIK_DASHBOARD_DOMAIN=traefik.universidad.localhost
EXTRACTOR_DOMAIN=extractor.universidad.localhost
API_ORCHESTRATOR_DOMAIN=api.universidad.localhost
DOCUMENT_SERVICE_DOMAIN=documents.universidad.localhost

# Nivel de logs de Traefik (DEBUG, INFO, WARN, ERROR)
TRAEFIK_LOG_LEVEL=INFO

# ==============================================================================
# Configuración de Caché Redis (Perfil 'cache' - Optimización Post-Baseline)
# IMPORTANTE REGLA TP:
# Durante las pruebas de carga baseline con k6 y Vegeta, Redis NO debe iniciarse.
# Para levantarlo: docker compose --profile cache up -d redis
# ==============================================================================
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
