# ==============================================================================
# Configuración de Entorno - PDF Infrastructure
# Traefik v3.6 Ingress Proxy, HashiCorp Consul Catalog, Dragonfly Cache y Resiliencia
# ==============================================================================

# Entorno de ejecución (development / staging / production)
ENVIRONMENT=development

# Puertos expuestos para Traefik
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# HashiCorp Consul (Catálogo y Registro Dinámico de Servicios)
# Restringido estrictamente a 127.0.0.1 por seguridad
CONSUL_HTTP_PORT=8500
CONSUL_HTTP_ADDR=http://consul:8500
CONSUL_RECONCILE_INTERVAL=10

# Nombre de la red externa compartida de Docker
DOCKER_NETWORK_NAME=pdf-network

# Dominios y Enrutamiento Traefik
BASE_DOMAIN=universidad.localhost
TRAEFIK_DASHBOARD_DOMAIN=traefik.universidad.localhost
EXTRACTOR_DOMAIN=extractor.universidad.localhost
API_ORCHESTRATOR_DOMAIN=api.universidad.localhost
DOCUMENT_SERVICE_DOMAIN=documents.universidad.localhost

# Nivel de logs de Traefik (DEBUG, INFO, WARN, ERROR)
TRAEFIK_LOG_LEVEL=INFO

# ==============================================================================
# Patrones de Resiliencia en Traefik (Rate Limit, Circuit Breaker y Retry)
# ==============================================================================
# Rate Limiting en Ingress para endpoint /extract (solicitudes/segundo y ráfaga)
RATE_LIMIT_EXTRACT_AVERAGE=10
RATE_LIMIT_EXTRACT_BURST=20

# Rate Limiting para la API Orchestrator (/process)
RATE_LIMIT_API_AVERAGE=20
RATE_LIMIT_API_BURST=40

# Expresión de Circuit Breaker para Traefik v3.6
CIRCUIT_BREAKER_EXPRESSION="NetworkErrorRatio() > 0.30 || ResponseCodeRatio(500, 600, 0, 600) > 0.25"

# Reintentos de conexión ante fallos transitorios / drenado de réplicas
RETRY_ATTEMPTS=3

# ==============================================================================
# Caché Dragonfly / Redis (Perfil 'cache' - Optimización POST-BASELINE)
# REGLA ESTRICTA DE LA CÁTEDRA:
# Durante la prueba de carga baseline con k6, Dragonfly/Redis NO debe iniciarse.
# Para levantarlo: docker compose --profile cache up -d dragonfly
# ==============================================================================
DRAGONFLY_PORT=6379
DRAGONFLY_URL=redis://dragonfly:6379/0
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=false

# ==============================================================================
# Autenticacion Inter-Servicios (Documents & API)
# ==============================================================================
DOCUMENTS_API_TOKEN=secret_token_integration_documents_32chars

# ==============================================================================
# Base de Datos MongoDB (Document Service)
# ==============================================================================
MONGODB_DATABASE=pdf_extractext_integration

# ==============================================================================
# Límites de Procesamiento de PDF
# ==============================================================================
MAX_UPLOAD_MB=20
MAX_UPLOAD_BYTES=20971520
MAX_CONCURRENT_REQUESTS=2
EXTRACTOR_TIMEOUT_SECONDS=30
DOCUMENT_TIMEOUT_SECONDS=5
READY_CHECK_TIMEOUT_SECONDS=2
